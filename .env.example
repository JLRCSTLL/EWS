# Server-only settings. Set these in Render, never in VITE_* variables.
DATABASE_URL=postgresql://user:password@host:5432/eligtas
NODE_ENV=production
PUBLIC_APP_URL=https://ews-kappa.vercel.app
ALLOWED_ORIGINS=https://ews-kappa.vercel.app
# Generate a long random owner setup key in Render. Never commit the real value.
BOOTSTRAP_TOKEN=
# Optional: Firebase service-account JSON for Android background notifications.
# Store only in Render's server environment. Never set this as VITE_*.
FCM_SERVICE_ACCOUNT_JSON=

# For local development omit DATABASE_URL and NODE_ENV.
# npm run server uses a persistent, git-ignored PGlite database in .local-data.
# npm run dev proxies /api to port 3001.
