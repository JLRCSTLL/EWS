{
  "name": "tanoviq-command-center",
  "productName": "AGILA Command Center",
  "version": "1.2.0",
  "description": "AGILA geospatial intelligence, life safety, and alerts.",
  "author": "AGILA",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ph.tanoviq.commandcenter",
    "productName": "AGILA Command Center",
    "copyright": "Copyright © 2026 AGILA",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "preload.cjs",
      "shell/**",
      "assets/agila.ico",
      "assets/agila-mark.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/agila.ico",
      "executableName": "AGILA Command Center",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "AGILA-Command-Center-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGILA Command Center",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "AGILA-Command-Center-Portable-${version}-${arch}.${ext}"
    }
  }
}
